# Kopieer dit bestand naar backend/.env en vul de waarden in

# JWT signing key (gebruik een lange willekeurige string in productie)
SECRET_KEY=change-this-to-a-long-random-secret-key

# Superuser (alleen bij lege database, daarna wordt het uit de DB gelezen)
ADMIN_USERNAME=sgieles
ADMIN_PASSWORD=change-me-in-production

# Database — lokaal SQLite, productie PostgreSQL (wordt ingesteld door Render)
DATABASE_URL=sqlite:///./vve_beheer.db
# DATABASE_URL=postgresql://user:password@host/dbname

# Upload map
UPLOAD_DIR=./uploads

# Microsoft Teams (optioneel)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
